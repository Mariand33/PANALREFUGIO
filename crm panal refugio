<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Panal Refugio · CRM interno</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --yellow:#f4c11f;--bg:#0b0b09;--panel:#141410;--line:#2a2a22;--text:#eee;--muted:#999;
  --danger:#e35b4f;--good:#5bc27a;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{height:100%;margin:0}
body{
  background:var(--bg);color:var(--text);
  font-family:"DM Sans",sans-serif;
  -webkit-font-smoothing:antialiased;
}
h1,h2,h3{font-family:"Bebas Neue",sans-serif;letter-spacing:.02em;color:var(--yellow);margin:0}
.wrap{max-width:1100px;margin:0 auto;padding:22px 18px 60px}
header.top{
  position:sticky;top:env(safe-area-inset-top,0px);z-index:10;
  background:rgba(11,11,9,.92);backdrop-filter:blur(6px);
  border-bottom:1px solid var(--line);padding:16px 18px;
}
header.top .wrap{padding:0;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:10px}
.brand b{font:400 30px "Bebas Neue";color:var(--yellow)}
.status{font-size:12px;color:var(--muted)}
.status.ok{color:var(--good)}
.status.err{color:var(--danger)}

.tabs{display:flex;gap:8px;margin:22px 0;flex-wrap:wrap}
.tab{
  background:var(--panel);border:1px solid var(--line);color:var(--muted);
  padding:10px 16px;border-radius:999px;font-weight:700;font-size:13px;cursor:pointer;
  transition:.15s;
}
.tab:hover{color:var(--text);border-color:#444}
.tab.active{background:var(--yellow);color:#111;border-color:var(--yellow)}
.view{display:none}
.view.active{display:block}

.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:800px){.grid{grid-template-columns:1fr}}

.card{
  background:var(--panel);border:1px solid var(--line);border-radius:14px;
  padding:22px;
}
.card h3{font-size:26px;margin-bottom:14px}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:22px}
@media(max-width:800px){.kpis{grid-template-columns:1fr 1fr}}
.kpi{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px}
.kpi span{display:block;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px}
.kpi b{font:400 32px "Bebas Neue";color:var(--yellow)}

label{display:block;font-size:12px;color:var(--muted);margin-bottom:5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em}
input,select,textarea{
  width:100%;background:#0f0f0c;border:1px solid var(--line);color:var(--text);
  padding:11px 12px;border-radius:8px;font-family:inherit;font-size:14px;margin-bottom:14px;
}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--yellow)}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
@media(max-width:600px){.row2,.row3{grid-template-columns:1fr}}
.check{display:flex;align-items:center;gap:8px;margin-bottom:14px}
.check input{width:auto;margin:0}

button.btn{
  background:var(--yellow);color:#111;border:0;padding:13px 20px;border-radius:8px;
  font-weight:800;cursor:pointer;font-size:14px;letter-spacing:.02em;
}
button.btn:hover{filter:brightness(1.08)}
button.btn.ghost{background:transparent;border:1px solid var(--line);color:var(--text)}
button.btn.small{padding:6px 10px;font-size:12px}
button.btn.danger{background:var(--danger);color:#fff}

table{width:100%;border-collapse:collapse;font-size:13px}
th,td{padding:10px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
th{color:var(--muted);text-transform:uppercase;font-size:11px;letter-spacing:.05em}
tr:hover td{background:#17170f}
.tbl-wrap{overflow-x:auto}
.pill{display:inline-block;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:700}
.pill.promo3{background:#3a2f0c;color:var(--yellow)}
.pill.promo2{background:#1c2f1c;color:#8fd39a}
.pill.promo1{background:#2a2020;color:#e39c93}
.pill.medio{background:#1c2333;color:#8fb3ff}
.pill.streaming{background:#2a1c33;color:#c98fff}
.muted{color:var(--muted)}
.empty{color:var(--muted);text-align:center;padding:30px 0;font-style:italic}
.foot-note{font-size:12px;color:var(--muted);margin-top:10px}
a{color:var(--yellow)}
</style>
</head>
<body>

<header class="top">
  <div class="wrap">
    <div class="brand">🐝 <b>Panal Refugio</b><span style="color:var(--muted);font-size:12px">· CRM interno</span></div>
    <div class="status" id="dbStatus">Conectando…</div>
  </div>
</header>

<div class="wrap">
  <h1 style="font-size:38px;margin-bottom:6px">Panel de control</h1>
  <p class="muted" style="margin:0 0 10px">Ventas, staff y comisiones, medios y streaming — todo el equipo ve lo mismo, en vivo.</p>

  <div class="kpis" id="kpis">
    <div class="kpi"><span>Entradas vendidas</span><b id="kpiTickets">0</b></div>
    <div class="kpi"><span>Recaudado</span><b id="kpiRevenue">$0</b></div>
    <div class="kpi"><span>Comisiones a pagar</span><b id="kpiCommission">$0</b></div>
    <div class="kpi"><span>Apariciones en medios</span><b id="kpiMedia">0</b></div>
  </div>

  <div class="tabs">
    <div class="tab active" data-view="ventas">Ventas de entradas</div>
    <div class="tab" data-view="staff">Staff &amp; comisiones</div>
    <div class="tab" data-view="medios">Medios &amp; streaming</div>
  </div>

  <!-- VENTAS -->
  <div class="view active" id="view-ventas">
    <div class="grid">
      <div class="card">
        <h3>Cargar una venta</h3>
        <form id="saleForm">
          <label>Vendedor/a (staff)</label>
          <input id="s_seller" required placeholder="Nombre del vendedor">
          <label>Comprador/a</label>
          <input id="s_buyer" required placeholder="Nombre del comprador">
          <div class="row2">
            <div>
              <label>Cantidad de entradas</label>
              <input id="s_qty" type="number" min="1" value="1" required>
            </div>
            <div>
              <label>Monto total cobrado ($)</label>
              <input id="s_amount" type="number" min="0" placeholder="15000" required>
            </div>
          </div>
          <label>Promoción aplicada</label>
          <select id="s_promo">
            <option value="3x1">3 × 1 (hasta 30/9)</option>
            <option value="2x1">2 × 1</option>
            <option value="1x1">Individual</option>
          </select>
          <div class="check">
            <input type="checkbox" id="s_third">
            <label style="margin:0" for="s_third">Venta a un tercero (genera comisión de $2.500)</label>
          </div>
          <label>Notas (opcional)</label>
          <textarea id="s_notes" rows="2" placeholder="Ej: pagó por transferencia, retira en puerta, etc."></textarea>
          <button class="btn" type="submit" style="width:100%">CARGAR VENTA</button>
        </form>
      </div>

      <div class="card">
        <h3>Últimas ventas</h3>
        <div class="tbl-wrap">
          <table id="salesTable">
            <thead><tr><th>Fecha</th><th>Vendedor</th><th>Comprador</th><th>Cant.</th><th>Monto</th><th>Promo</th><th></th></tr></thead>
            <tbody></tbody>
          </table>
          <div class="empty" id="salesEmpty" style="display:none">Todavía no hay ventas cargadas.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- STAFF -->
  <div class="view" id="view-staff">
    <div class="card">
      <h3>Comisiones por vendedor/a</h3>
      <p class="foot-note">$2.500 por cada entrada vendida y cobrada a un tercero. Las compras propias no generan comisión.</p>
      <div class="tbl-wrap">
        <table id="staffTable">
          <thead><tr><th>Vendedor/a</th><th>Entradas vendidas</th><th>Recaudado</th><th>Comisión a cobrar</th></tr></thead>
          <tbody></tbody>
        </table>
        <div class="empty" id="staffEmpty" style="display:none">Todavía no hay ventas registradas.</div>
      </div>
    </div>
  </div>

  <!-- MEDIOS -->
  <div class="view" id="view-medios">
    <div class="grid">
      <div class="card">
        <h3>Cargar visita / mención</h3>
        <form id="mediaForm">
          <label>Tipo</label>
          <select id="m_type">
            <option value="medio">Medio de comunicación</option>
            <option value="streaming">Streaming / podcast</option>
          </select>
          <label>Título / medio</label>
          <input id="m_title" required placeholder="Ej: Radio Sonar, nota en vivo">
          <div class="row2">
            <div>
              <label>Fecha</label>
              <input id="m_date" type="date">
            </div>
            <div>
              <label>Link (opcional)</label>
              <input id="m_link" placeholder="https://...">
            </div>
          </div>
          <label>Notas</label>
          <textarea id="m_notes" rows="2" placeholder="Alcance, reacciones, quién fue"></textarea>
          <button class="btn" type="submit" style="width:100%">CARGAR</button>
        </form>
      </div>

      <div class="card">
        <h3>Historial de medios y streaming</h3>
        <div class="tbl-wrap">
          <table id="mediaTable">
            <thead><tr><th>Fecha</th><th>Tipo</th><th>Título</th><th></th></tr></thead>
            <tbody></tbody>
          </table>
          <div class="empty" id="mediaEmpty" style="display:none">Todavía no hay entradas cargadas.</div>
        </div>
      </div>
    </div>
  </div>

  <p class="foot-note" style="margin-top:30px">
    Los datos se guardan compartidos: cualquier integrante del equipo que abra este panel ve la misma información en tiempo real.
  </p>
</div>

<script>
let db = null;
let sales = [];
let media = [];
const money = n => '$' + Math.round(n).toLocaleString('es-AR');

function setStatus(text, cls){
  const el = document.getElementById('dbStatus');
  el.textContent = text;
  el.className = 'status ' + (cls || '');
}

// tabs
document.querySelectorAll('.tab').forEach(tab=>{
  tab.addEventListener('click', ()=>{
    document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
    document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById('view-'+tab.dataset.view).classList.add('active');
  });
});

function renderKPIs(){
  const tickets = sales.reduce((a,s)=>a+Number(s.qty||0),0);
  const revenue = sales.reduce((a,s)=>a+Number(s.amount||0),0);
  const commission = sales.reduce((a,s)=> a + (s.third ? Number(s.qty||0)*2500 : 0), 0);
  document.getElementById('kpiTickets').textContent = tickets;
  document.getElementById('kpiRevenue').textContent = money(revenue);
  document.getElementById('kpiCommission').textContent = money(commission);
  document.getElementById('kpiMedia').textContent = media.length;
}

function promoLabel(p){
  if(p==='3x1') return '<span class="pill promo3">3×1</span>';
  if(p==='2x1') return '<span class="pill promo2">2×1</span>';
  return '<span class="pill promo1">1×1</span>';
}

function renderSales(){
  const tbody = document.querySelector('#salesTable tbody');
  tbody.innerHTML = '';
  const sorted = [...sales].sort((a,b)=> (b.createdAt||0)-(a.createdAt||0));
  document.getElementById('salesEmpty').style.display = sorted.length ? 'none' : 'block';
  for(const s of sorted){
    const tr = document.createElement('tr');
    const date = s.createdAt ? new Date(s.createdAt).toLocaleDateString('es-AR') : '-';
    tr.innerHTML = `<td>${date}</td><td>${esc(s.seller)}</td><td>${esc(s.buyer)}</td>
      <td>${s.qty}</td><td>${money(s.amount)}</td><td>${promoLabel(s.promo)}</td>
      <td><button class="btn small danger" data-id="${s.id}" data-kind="sale">✕</button></td>`;
    tbody.appendChild(tr);
  }
  renderStaff();
  renderKPIs();
}

function renderStaff(){
  const bySeller = {};
  for(const s of sales){
    const key = s.seller || 'Sin nombre';
    if(!bySeller[key]) bySeller[key] = {qty:0, revenue:0, commission:0};
    bySeller[key].qty += Number(s.qty||0);
    bySeller[key].revenue += Number(s.amount||0);
    if(s.third) bySeller[key].commission += Number(s.qty||0)*2500;
  }
  const tbody = document.querySelector('#staffTable tbody');
  tbody.innerHTML = '';
  const names = Object.keys(bySeller).sort((a,b)=> bySeller[b].commission - bySeller[a].commission);
  document.getElementById('staffEmpty').style.display = names.length ? 'none' : 'block';
  for(const name of names){
    const d = bySeller[name];
    const tr = document.createElement('tr');
    tr.innerHTML = `<td><b>${esc(name)}</b></td><td>${d.qty}</td><td>${money(d.revenue)}</td><td>${money(d.commission)}</td>`;
    tbody.appendChild(tr);
  }
}

function renderMedia(){
  const tbody = document.querySelector('#mediaTable tbody');
  tbody.innerHTML = '';
  const sorted = [...media].sort((a,b)=> (b.createdAt||0)-(a.createdAt||0));
  document.getElementById('mediaEmpty').style.display = sorted.length ? 'none' : 'block';
  for(const m of sorted){
    const tr = document.createElement('tr');
    const date = m.date || (m.createdAt ? new Date(m.createdAt).toLocaleDateString('es-AR') : '-');
    const title = m.link ? `<a href="${esc(m.link)}" target="_blank" rel="noopener">${esc(m.title)}</a>` : esc(m.title);
    tr.innerHTML = `<td>${date}</td><td><span class="pill ${m.type}">${m.type==='streaming'?'Streaming':'Medio'}</span></td>
      <td>${title}</td><td><button class="btn small danger" data-id="${m.id}" data-kind="media">✕</button></td>`;
    tbody.appendChild(tr);
  }
  renderKPIs();
}

function esc(str){
  return String(str||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

async function loadAll(){
  if(!db) return;
  try{
    const salesSnap = await db.collection('sales').get();
    sales = salesSnap.docs.map(d=>({id:d.id, ...d.data()}));
    const mediaSnap = await db.collection('media').get();
    media = mediaSnap.docs.map(d=>({id:d.id, ...d.data()}));
    renderSales(); renderMedia();
  }catch(e){
    console.error(e);
    setStatus('No se pudo cargar la información.', 'err');
  }
}

async function init(){
  try{
    db = await claude.use('db');
    if(!db){
      setStatus('Este panel necesita abrirse dentro de Claude para guardar datos compartidos.', 'err');
      return;
    }
    setStatus('Conectado · datos en vivo', 'ok');
    await loadAll();
    db.collection('sales').onSnapshot(snap=>{
      sales = snap.docs.map(d=>({id:d.id, ...d.data()}));
      renderSales();
    });
    db.collection('media').onSnapshot(snap=>{
      media = snap.docs.map(d=>({id:d.id, ...d.data()}));
      renderMedia();
    });
  }catch(e){
    console.error(e);
    setStatus('No se pudo conectar la base de datos compartida.', 'err');
  }
}
init();

document.getElementById('saleForm').addEventListener('submit', async (e)=>{
  e.preventDefault();
  if(!db){ alert('No hay conexión a la base compartida todavía.'); return; }
  const payload = {
    seller: document.getElementById('s_seller').value.trim(),
    buyer: document.getElementById('s_buyer').value.trim(),
    qty: Number(document.getElementById('s_qty').value || 1),
    amount: Number(document.getElementById('s_amount').value || 0),
    promo: document.getElementById('s_promo').value,
    third: document.getElementById('s_third').checked,
    notes: document.getElementById('s_notes').value.trim(),
    createdAt: Date.now()
  };
  try{
    const id = 'sale_' + Date.now() + '_' + Math.random().toString(36).slice(2,7);
    await db.doc('sales/'+id).set(payload);
    e.target.reset();
    document.getElementById('s_qty').value = 1;
  }catch(err){
    console.error(err);
    alert('No se pudo guardar la venta.');
  }
});

document.getElementById('mediaForm').addEventListener('submit', async (e)=>{
  e.preventDefault();
  if(!db){ alert('No hay conexión a la base compartida todavía.'); return; }
  const payload = {
    type: document.getElementById('m_type').value,
    title: document.getElementById('m_title').value.trim(),
    date: document.getElementById('m_date').value,
    link: document.getElementById('m_link').value.trim(),
    notes: document.getElementById('m_notes').value.trim(),
    createdAt: Date.now()
  };
  try{
    const id = 'media_' + Date.now() + '_' + Math.random().toString(36).slice(2,7);
    await db.doc('media/'+id).set(payload);
    e.target.reset();
  }catch(err){
    console.error(err);
    alert('No se pudo guardar el registro.');
  }
});

document.addEventListener('click', async (e)=>{
  const btn = e.target.closest('button[data-kind]');
  if(!btn) return;
  const kind = btn.dataset.kind, id = btn.dataset.id;
  if(!confirm('¿Eliminar este registro?')) return;
  try{
    await db.doc((kind==='sale'?'sales/':'media/')+id).delete();
  }catch(err){
    console.error(err);
    alert('No se pudo eliminar.');
  }
});
</script>
</body>
</html>
